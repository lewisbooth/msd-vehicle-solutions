// Template for an additional isolated Preview branch if its D1 ID differs.
// Its matching Worker previews.d1_databases binding must use the same ID.
// The tracked wrangler.preview-migrations.jsonc is the current CI target.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "msd-vehicle-solutions-preview-migrations",
  "compatibility_date": "2026-09-24",
  "d1_databases": [{
    "binding": "PREVIEW_DB",
    "database_name": "msd-vehicle-solutions-preview",
    "database_id": "REPLACE_WITH_PREVIEW_D1_ID",
    "migrations_dir": "./migrations"
  }]
}
