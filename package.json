{
  "name": "msd-vehicle-solutions",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "build": "npm run build:public && npm run typecheck && npm run build:admin",
    "typecheck": "tsc --noEmit -p tsconfig.worker.json",
    "build:public": "node scripts/prepare-static.mjs && vite build --config vite.public.config.mjs && node scripts/copy-static.mjs && node scripts/build-public.mjs",
    "build:admin": "vite build --config vite.admin.config.mjs",
    "migrate:production": "node scripts/migrate-production.mjs",
    "deploy:production": "npm run migrate:production && wrangler deploy"
  },
  "dependencies": {
    "jose": "^6.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.135.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
